# SpecterRed X - environment template (NO real secrets).
# The entire core demo works WITHOUT any of these set.

# Backend database (defaults to a local SQLite file next to the backend package).
# SPECTERRED_DB_URL=sqlite:///./specterred.db

# CORS origins for the dev frontend (comma-separated).
# SPECTERRED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM narrative assist. LEAVE BLANK for deterministic-only mode.
# All three are required to enable "LLM-assisted narrative" mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Frontend -> backend base URL (Vite).
# VITE_API_BASE=http://127.0.0.1:8000
